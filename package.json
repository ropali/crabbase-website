{
  "name": "crabbase-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Static landing page and documentation for Crabbase, built on one plain CSS system.",
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "build:docs": "node scripts/sync-docs.mjs && node scripts/build-docs.mjs",
    "build": "npm run build:docs && node scripts/build.mjs",
    "dev": "npm run build:docs && node scripts/serve.mjs .",
    "preview": "npm run build && node scripts/serve.mjs"
  },
  "devDependencies": {
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2"
  }
}
